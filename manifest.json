{
  "manifest_version": 3,
  "name": "Price Auto Converter",
  "version": "1.1.1",
  "description": "Convert supported prices to your currency, with original-price hints, rate freshness and simple per-site controls.",
  "minimum_chrome_version": "113.0.5672.63",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://open.er-api.com/*",
    "https://cdn.jsdelivr.net/npm/@fawazahmed0/*",
    "https://script.google.com/macros/s/AKfycbywCi0gdsT6oWOMTO6HKgQ5Ngg6ceNHE7g5mu796fSZPldz5wqEbPuHiI5njqsub0FtJQ/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Price Auto Converter",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib.js",
        "diagnostics.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "Price Auto"
}
