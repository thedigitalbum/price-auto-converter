{
  "manifest_version": 3,
  "name": "Price Auto Converter – Convert Prices to Your Currency",
  "version": "1.0.2",
  "description": "Auto-detects prices on any site and converts them to your currency. Converted prices are marked, and hovering shows the original.",
  "minimum_chrome_version": "105",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://open.er-api.com/*",
    "https://cdn.jsdelivr.net/npm/@fawazahmed0/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Price Auto Converter",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "Price Auto"
}
